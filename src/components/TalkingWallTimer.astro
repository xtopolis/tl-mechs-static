---
// TalkingWallTimer: shows the Talking Wall event in the viewer's LOCAL time.
// Math is anchored to a known 10-min warning (Mon 2026-07-06 7:04:43 PM Pacific);
// the shown start time is that + 10 min (the real warning->start gap is ~9m37s,
// rounded to 10m — close enough). Recurs every 3h16m45s. For the first 5 min after
// a start the page shows the in-progress event, then switches to the next one.
// BETA — assumes a perfectly regular cadence.
---

<p class="tw-timer not-content">
  <span><span data-role="tw-label">Next event at </span><span class="tw-time" data-role="tw-time">…</span></span>
  <span class="tw-beta">(beta)</span>
</p>

<script is:inline>
  (() => {
    const timeEl = document.querySelector('.tw-timer [data-role="tw-time"]');
    const labelEl = document.querySelector('.tw-timer [data-role="tw-label"]');
    if (!timeEl || !labelEl) return;
    // Anchor: 10-min warning Mon 2026-07-06 7:04:43 PM Pacific (PDT, UTC-7) = 2026-07-07 02:04:43 UTC
    const ANCHOR = Date.UTC(2026, 6, 7, 2, 4, 43);
    const INTERVAL = (3 * 3600 + 16 * 60 + 45) * 1000; // 3h 16m 45s
    const DISPLAY_OFFSET = 10 * 60 * 1000; // warning -> shown start time (~10 min)
    const LIVE_WINDOW = 5 * 60 * 1000;     // keep showing the event 5 min past its start

    function fmt(t) {
      return new Date(t).toLocaleTimeString([], {
        hour: 'numeric',
        minute: '2-digit',
        hour12: true,
      });
    }

    function update() {
      const now = Date.now();
      const firstStart = ANCHOR + DISPLAY_OFFSET;
      const n = Math.floor((now - firstStart) / INTERVAL);
      const currentStart = firstStart + n * INTERVAL;
      if (now < currentStart + LIVE_WINDOW) {
        labelEl.textContent = 'Event in progress — started ';
        timeEl.textContent = fmt(currentStart);
      } else {
        labelEl.textContent = 'Next event at ';
        timeEl.textContent = fmt(currentStart + INTERVAL);
      }
    }

    update();
    setInterval(update, 30000);
  })();
</script>

<style>
  .tw-timer {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    flex-wrap: wrap;
    margin: 0.75rem 0 1.25rem;
    font-size: 0.95rem;
    text-align: center;
  }
  .tw-time {
    /* theme-tuned accent text: bright on dark, dark on light */
    color: var(--sl-color-text-accent);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .tw-beta {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--sl-color-gray-3);
  }
</style>
