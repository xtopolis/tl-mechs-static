---
// TalkingWallTimer: shows the approximate time of the next Talking Wall event in
// the viewer's LOCAL time. Recurs every 3h16m17s, anchored to a known occurrence
// (Sun 2026-07-05 1:43:43 PM Pacific). BETA — assumes a perfectly regular cadence.
---

<p class="tw-timer not-content">
  <span>Next event at <span class="tw-time" data-role="tw-time">…</span></span>
  <span class="tw-beta">(beta)</span>
</p>

<script is:inline>
  (() => {
    const el = document.querySelector('.tw-timer [data-role="tw-time"]');
    if (!el) return;
    // Anchor: Sun 2026-07-05 1:43:43 PM Pacific (PDT, UTC-7) = 2026-07-05 20:43:43 UTC
    const ANCHOR = Date.UTC(2026, 6, 5, 20, 43, 43);
    const INTERVAL = (3 * 3600 + 16 * 60 + 17) * 1000; // 3h 16m 17s

    function update() {
      const now = Date.now();
      const n = Math.floor((now - ANCHOR) / INTERVAL) + 1;
      const next = new Date(ANCHOR + n * INTERVAL);
      el.textContent = next.toLocaleTimeString([], {
        hour: 'numeric',
        minute: '2-digit',
        hour12: true,
      });
    }

    update();
    setInterval(update, 30000);
  })();
</script>

<style>
  .tw-timer {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    flex-wrap: wrap;
    margin: 0.75rem 0 1.25rem;
    font-size: 0.95rem;
    text-align: center;
  }
  .tw-time {
    /* theme-tuned accent text: bright on dark, dark on light */
    color: var(--sl-color-text-accent);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .tw-beta {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--sl-color-gray-3);
  }
</style>
